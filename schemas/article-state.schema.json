{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "article-state.schema.json",
  "title": "WeChat ArticleState v0.7",
  "type": "object",
  "required": [
    "version", "article_id", "account", "production", "workflow", "signal",
    "topic", "research", "author", "architecture", "writing", "blind_review",
    "visual", "qa", "publishing", "publication", "performance", "learning"
  ],
  "properties": {
    "version": {"const": "0.7"},
    "article_id": {"type": "string"},
    "account": {"type": "string"},
    "production": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["flash", "standard", "deep"]},
        "target_word_count": {"type": ["integer", "null"], "minimum": 0},
        "deadline": {"type": "string"},
        "mode_reason": {"type": "string"}
      }
    },
    "workflow": {
      "type": "object",
      "required": ["stage", "gate", "blocked_by", "return_to", "retry_count"],
      "properties": {
        "stage": {"enum": ["signal", "topic", "research", "author", "architecture", "writing", "blind_review", "visual", "qa", "publishing", "published", "reviewed"]},
        "gate": {"enum": ["ready", "blocked", "rework", "manual_review"]},
        "blocked_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "return_to": {"type": "string"},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    },
    "signal": {"type": "object"},
    "topic": {
      "type": "object",
      "properties": {
        "tension_test": {"type": "object"},
        "reader_promise": {
          "type": "object",
          "required": ["promise_type", "promise", "provisional_answer", "delivery_shape", "delivery_preview", "status"],
          "properties": {
            "promise_type": {"enum": ["which", "how", "why", "compare", "decide", "explain", "list", "other"]},
            "promise": {"type": "string"},
            "provisional_answer": {"type": "string"},
            "delivery_shape": {"enum": ["numbered_framework", "decision_tree", "comparison", "checklist", "narrative", "hybrid"]},
            "delivery_preview": {"type": "array"},
            "status": {"enum": ["pass", "weak", "fail", "unknown"]}
          }
        },
        "delivery_potential": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "research": {
      "type": "object",
      "required": ["source_registry", "claims", "calculations", "originality_gate"],
      "properties": {
        "source_registry": {"type": "array", "items": {"$ref": "source.schema.json"}},
        "claims": {"type": "array", "items": {"$ref": "claim.schema.json"}},
        "calculations": {"type": "array", "items": {"$ref": "calculation.schema.json"}},
        "uncertainty_nodes": {"type": "array"},
        "depth_material": {"type": "array"},
        "originality_gate": {"type": "object"}
      }
    },
    "author": {
      "type": "object",
      "required": [
        "why_write", "pov_candidates", "rejected_pov_ids", "selected_pov_id",
        "provisional_core_answer", "entry_point", "material_graveyard", "selection_stats",
        "narrative_choice", "voice_profile", "voice_calibration", "humanity_test"
      ],
      "properties": {
        "why_write": {"type": "string"},
        "pov_candidates": {"type": "array"},
        "rejected_pov_ids": {"type": "array", "items": {"type": "string"}},
        "selected_pov_id": {"type": "string"},
        "pov": {"type": "array"},
        "provisional_core_answer": {"type": "string"},
        "entry_point": {"type": "object"},
        "personal_material": {"type": "array"},
        "material_graveyard": {"type": "array"},
        "selection_stats": {
          "type": "object",
          "required": ["retained_units", "discarded_units"],
          "properties": {
            "retained_units": {"type": "integer", "minimum": 0},
            "discarded_units": {"type": "integer", "minimum": 0}
          }
        },
        "uncertainty_usage": {"type": "array"},
        "narrative_choice": {"type": "string"},
        "voice_profile": {"type": "string"},
        "voice_calibration": {"enum": ["calibrated", "partial", "uncalibrated"]},
        "humanity_test": {"type": "object"}
      }
    },
    "architecture": {
      "type": "object",
      "required": ["reader_contract", "thesis_prominence", "structure"],
      "properties": {
        "reader_contract": {
          "type": "object",
          "required": ["promise_type", "promise", "core_answer", "answer_shape", "expected_units", "delivery_units"],
          "properties": {
            "promise_type": {"enum": ["which", "how", "why", "compare", "decide", "explain", "list", "other"]},
            "promise": {"type": "string"},
            "core_answer": {"type": "string"},
            "answer_shape": {"enum": ["numbered_framework", "decision_tree", "comparison", "checklist", "narrative", "hybrid"]},
            "expected_units": {"type": "integer", "minimum": 0},
            "delivery_units": {"type": "array"}
          }
        },
        "thesis_prominence": {
          "type": "object",
          "required": ["required_in_first_screen", "max_chars", "delayed_reason"],
          "properties": {
            "required_in_first_screen": {"type": "boolean"},
            "max_chars": {"type": "integer", "minimum": 1},
            "delayed_reason": {"type": "string"}
          }
        },
        "first_screen_plan": {"type": "object"},
        "structure": {"type": "array"}
      }
    },
    "writing": {
      "type": "object",
      "required": ["title_candidates", "selected_title", "sections", "body_status", "generation_trace", "clarity_pass", "anti_template_pass", "blind_review_packet"],
      "properties": {
        "title_candidates": {"type": "array"},
        "selected_title": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "writing-section.schema.json"}},
        "body_status": {"enum": ["not_started", "draft", "revised", "final"]},
        "word_count": {"type": ["integer", "null"], "minimum": 0},
        "generation_trace": {"type": "object"},
        "clarity_pass": {
          "type": "object",
          "required": [
            "status", "first_screen_excerpt", "thesis_in_first_screen", "promise_delivery_status",
            "numbered_framework_used", "missing_delivery_units", "evidence_overload_first_screen",
            "concrete_task_coverage", "edits_made"
          ],
          "properties": {
            "status": {"enum": ["not_run", "pass", "rework"]},
            "first_screen_excerpt": {"type": "string"},
            "thesis_in_first_screen": {"type": "boolean"},
            "promise_delivery_status": {"enum": ["not_run", "pass", "rework"]},
            "numbered_framework_used": {"type": "boolean"},
            "missing_delivery_units": {"type": "array"},
            "evidence_overload_first_screen": {"type": "boolean"},
            "concrete_task_coverage": {"enum": ["not_run", "pass", "rework"]},
            "edits_made": {"type": "array"}
          }
        },
        "anti_template_pass": {"type": "object"},
        "blind_review_packet": {"type": "object"},
        "risk_notes": {"type": "array"}
      }
    },
    "blind_review": {"type": "object"},
    "visual": {
      "type": "object",
      "required": ["planning_status", "execution_status", "assets_ready"],
      "properties": {
        "planning_status": {"enum": ["not_started", "planned", "complete"]},
        "execution_status": {"enum": ["not_started", "partial", "complete", "unavailable"]},
        "assets_ready": {"type": "boolean"},
        "cover": {"type": "object"},
        "inline_images": {"type": "array", "items": {"$ref": "visual-asset.schema.json"}},
        "rights_risks": {"type": "array"}
      }
    },
    "qa": {"type": "object"},
    "publishing": {"type": "object"},
    "publication": {"type": "object"},
    "performance": {"type": "object"},
    "experiment": {"type": "object"},
    "learning": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qa": {
            "properties": {
              "status": {"const": "A"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "visual": {
            "properties": {
              "assets_ready": {"const": true}
            }
          },
          "workflow": {
            "properties": {
              "gate": {"const": "ready"}
            }
          },
          "writing": {
            "properties": {
              "clarity_pass": {
                "properties": {
                  "status": {"const": "pass"},
                  "promise_delivery_status": {"const": "pass"},
                  "concrete_task_coverage": {"const": "pass"}
                }
              },
              "anti_template_pass": {
                "properties": {
                  "status": {"const": "pass"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
