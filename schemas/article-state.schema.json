{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "article-state.schema.json",
  "title": "WeChat ArticleState v0.5",
  "type": "object",
  "required": ["version", "article_id", "account", "production", "workflow", "signal", "topic", "research", "author", "architecture", "writing", "visual", "qa", "publishing", "publication", "performance", "learning"],
  "properties": {
    "version": {"const": "0.5"},
    "article_id": {"type": "string"},
    "account": {"type": "string"},
    "production": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["flash", "standard", "deep"]},
        "target_word_count": {"type": ["integer", "null"], "minimum": 0},
        "deadline": {"type": "string"},
        "mode_reason": {"type": "string"}
      }
    },
    "workflow": {
      "type": "object",
      "required": ["stage", "gate", "blocked_by", "return_to", "retry_count"],
      "properties": {
        "stage": {"enum": ["signal", "topic", "research", "author", "architecture", "writing", "visual", "qa", "publishing", "published", "reviewed"]},
        "gate": {"enum": ["ready", "blocked", "rework", "manual_review"]},
        "blocked_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "return_to": {"type": "string"},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    },
    "signal": {"type": "object"},
    "topic": {"type": "object"},
    "research": {
      "type": "object",
      "required": ["source_registry", "claims", "calculations", "originality_gate"],
      "properties": {
        "source_registry": {"type": "array", "items": {"$ref": "source.schema.json"}},
        "claims": {"type": "array", "items": {"$ref": "claim.schema.json"}},
        "calculations": {"type": "array", "items": {"$ref": "calculation.schema.json"}},
        "originality_gate": {"type": "object"}
      }
    },
    "author": {
      "type": "object",
      "required": ["why_write", "pov", "entry_point", "material_to_ignore", "narrative_choice", "voice_profile", "voice_traits", "banned_moves", "humanity_test"],
      "properties": {
        "why_write": {"type": "string"},
        "pov": {"type": "array", "items": {"type": "string"}},
        "entry_point": {
          "type": "object",
          "required": ["type", "content", "evidence_refs"],
          "properties": {
            "type": {"type": "string"},
            "content": {"type": "string"},
            "evidence_refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "personal_material": {"type": "array"},
        "material_to_ignore": {"type": "array"},
        "narrative_choice": {"enum": ["", "single-thread", "scene-led", "evidence-led", "argument-led", "case-led", "diary-led", "compare-led"]},
        "voice_profile": {"type": "string"},
        "voice_traits": {"type": "array", "items": {"type": "string"}},
        "preferred_moves": {"type": "array", "items": {"type": "string"}},
        "banned_moves": {"type": "array", "items": {"type": "string"}},
        "first_person_level": {"enum": ["none", "low", "medium", "high"]},
        "looseness": {"enum": ["tight", "natural", "conversational"]},
        "humanity_test": {"type": "object"}
      }
    },
    "architecture": {"type": "object"},
    "writing": {
      "type": "object",
      "required": ["title_candidates", "selected_title", "sections", "body_status", "anti_template_pass"],
      "properties": {
        "title_candidates": {"type": "array"},
        "selected_title": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "writing-section.schema.json"}},
        "body_status": {"enum": ["not_started", "draft", "revised", "final"]},
        "word_count": {"type": ["integer", "null"], "minimum": 0},
        "anti_template_pass": {
          "type": "object",
          "required": ["status", "detected_patterns", "edits_made"],
          "properties": {
            "status": {"enum": ["not_run", "pass", "rework"]},
            "detected_patterns": {"type": "array"},
            "edits_made": {"type": "array"}
          }
        },
        "risk_notes": {"type": "array"}
      }
    },
    "visual": {
      "type": "object",
      "required": ["planning_status", "execution_status", "assets_ready"],
      "properties": {
        "planning_status": {"enum": ["not_started", "planned", "complete"]},
        "execution_status": {"enum": ["not_started", "partial", "complete", "unavailable"]},
        "assets_ready": {"type": "boolean"},
        "cover": {"type": "object"},
        "inline_images": {"type": "array", "items": {"$ref": "visual-asset.schema.json"}},
        "rights_risks": {"type": "array"}
      }
    },
    "qa": {"type": "object"},
    "publishing": {"type": "object"},
    "publication": {"type": "object"},
    "performance": {"type": "object"},
    "experiment": {"type": "object"},
    "learning": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"qa": {"properties": {"status": {"const": "A"}}}}},
      "then": {
        "properties": {
          "visual": {"properties": {"assets_ready": {"const": true}}},
          "workflow": {"properties": {"gate": {"const": "ready"}}},
          "writing": {"properties": {"anti_template_pass": {"properties": {"status": {"const": "pass"}}}}}
        }
      }
    }
  ]
}
